<Window x:Class="ShoeAccounting.Views.Windows.OrderManagmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeAccounting.Views.Windows"
        xmlns:converters="clr-namespace:ShoeAccounting.Utils"
        mc:Ignorable="d"
        Title="Управление заказами" Height="Auto" Width="1200"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/Images/Icon.ico"
        FontFamily="Times New Roman"
        FontSize="18">
    
    <Window.Resources>
        <converters:OrderManagmentSettingsToTitle x:Key="OrderManagmentSettingsToTitle"/>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="3"
                   Text="{Binding IsOrderNew, Converter={StaticResource OrderManagmentSettingsToTitle}}"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Статус заказа *"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,3"/>
            <ComboBox x:Name="orderStatusComboBox"
                      ItemsSource="{Binding Statuses}"
                      SelectedValue="{Binding CurrentOrder.OrderStatus, UpdateSourceTrigger=PropertyChanged}"
                      Height="28"
                      FontSize="14"
                      Padding="3"
                      SelectedIndex="0"/>

            <TextBlock Text="Адрес пункта выдачи *"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,15,0,3"/>
            <ComboBox x:Name="productCategoryComboBox"
                      ItemsSource="{Binding PickUpPoints}"
                      DisplayMemberPath="DisplayAddress"
                      SelectedValuePath="PickUpPointId"
                      SelectedValue="{Binding CurrentOrder.PickUpPointId, UpdateSourceTrigger=PropertyChanged}"
                      Height="28"
                      FontSize="14"
                      Padding="3"/>

            <TextBlock Text="Дата заказ *"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,15,0,3"/>
            <DatePicker x:Name="orderDatePicker"
                        IsEnabled="False"
                        SelectedDate="{Binding OrderDateMakeDateTime, UpdateSourceTrigger=PropertyChanged}"
                        SelectedDateChanged="orderDatePicker_SelectedDateChanged"
                        
                        Height="28"
                        FontSize="14"
                        Padding="3"/>

            <TextBlock Text="Дата доставки *"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,15,0,3"/>
            <DatePicker x:Name="deliveryDatePicker"
                        SelectedDate="{Binding OrderDateReceiptDateTime, UpdateSourceTrigger=PropertyChanged}"
                        Height="28"
                        FontSize="14"
                        Padding="3"/>
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Grid.Row="2">
            <Button Content="Добавить товар" 
                    Click="AddPositionButton_Click"
                    Height="32"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,10"/>

            <ListView x:Name="positionsListView" 
                      BorderBrush="Gray" BorderThickness="1"
                      MaxHeight="300"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Кол-во" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity}" 
                                             Width="60" 
                                             TextAlignment="Center"
                                             PreviewTextInput="NumberValidationTextBox_PreviewTextInput"
                                             DataObject.Pasting="NumberValidationTextBox_Pasting"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Артикул" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding SelectedProduct}"
                                              DisplayMemberPath="ProductArticle"
                                              Width="110"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Название" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProductTitle}" 
                                               FontStyle="Italic"
                                               Foreground="#616161"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Действие" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Удалить" 
                                            Width="Auto" Height="26"
                                            Click="RemovePositionButton_Click"
                                            Tag="{Binding}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="saveOrderButton" 
                    Content="Сохранить"
                    Width="120"
                    Height="35"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Margin="5"
                    Background="#4CAF50"
                    Foreground="White"
                    Click="saveOrderButton_Click"/>

            <Button x:Name="cancelButton" 
                    Content="Отмена"
                    Width="120"
                    Height="35"
                    FontSize="14"
                    Margin="5"
                    Click="cancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

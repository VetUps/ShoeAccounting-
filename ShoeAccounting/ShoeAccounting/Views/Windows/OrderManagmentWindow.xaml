<Window x:Class="ShoeAccounting.Views.Windows.OrderManagmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeAccounting.Views.Windows"
        mc:Ignorable="d"
        Title="Управление заказами" Height="Auto" Width="600"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/Images/Icon.ico"
        FontFamily="Times New Roman"
        FontSize="18">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding IsOrderNew}"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Артикул *"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,3"/>
            <ComboBox x:Name="productsArticleComboBox"
                      ItemsSource="{Binding Products}"
                      DisplayMemberPath="ProductArticle"
                      SelectedValuePath="ProductArticle"
                      SelectedValue="{Binding CurrentOrder.ProductArticle, UpdateSourceTrigger=PropertyChanged}"
                      Height="28"
                      FontSize="14"
                      Padding="3"/>

            <TextBlock Text="Статус заказа *"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,15,0,3"/>
            <ComboBox x:Name="orderStatusComboBox"
                      ItemsSource="{Binding Statuses}"
                      SelectedValue="{Binding CurrentOrder.OrderStatus, UpdateSourceTrigger=PropertyChanged}"
                      Height="28"
                      FontSize="14"
                      Padding="3"
                      SelectedIndex="0"/>

            <TextBlock Text="Адрес пункта выдачи *"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,15,0,3"/>
            <ComboBox x:Name="productCategoryComboBox"
                      ItemsSource="{Binding PickUpPoints}"
                      DisplayMemberPath="DisplayAddress"
                      SelectedValuePath="PickUpPointId"
                      SelectedValue="{Binding CurrentOrder.PickUpPointId, UpdateSourceTrigger=PropertyChanged}"
                      Height="28"
                      FontSize="14"
                      Padding="3"/>

            <TextBlock Text="Дата заказ *"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,15,0,3"/>
            <DatePicker x:Name="orderDatePicker"
                        SelectedDate="{Binding OrderDateMakeDateTime, UpdateSourceTrigger=PropertyChanged}"
                        SelectedDateChanged="orderDatePicker_SelectedDateChanged"
                        Height="28"
                        FontSize="14"
                        Padding="3"/>

            <TextBlock Text="Дата доставки *"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,15,0,3"/>
            <DatePicker x:Name="deliveryDatePicker"
                        SelectedDate="{Binding OrderDateReceiptDateTime, UpdateSourceTrigger=PropertyChanged}"
                        Height="28"
                        FontSize="14"
                        Padding="3"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="saveOrderButton" 
                    Content="Сохранить"
                    Width="120"
                    Height="35"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Margin="5"
                    Background="#4CAF50"
                    Foreground="White"
                    Click="saveOrderButton_Click"/>

            <Button x:Name="cancelButton" 
                    Content="Отмена"
                    Width="120"
                    Height="35"
                    FontSize="14"
                    Margin="5"
                    Click="cancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

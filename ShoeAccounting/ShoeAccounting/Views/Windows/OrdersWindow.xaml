<Window x:Class="ShoeAccounting.Views.Windows.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeAccounting.Views.Windows"
        xmlns:controls="clr-namespace:ShoeAccounting.Views.Controll"
        xmlns:converters="clr-namespace:ShoeAccounting.Utils"
        mc:Ignorable="d"
        Title="Заказы" 
        Height="720" Width="1280"
        FontFamily="Times New Roman"
        Icon="/Resources/Images/Icon.ico">
    
    <Window.Resources>
        <converters:ProductListCountToVisibility x:Key="ProductListCountToCollapsed" Invert="True"/>
        <converters:AddOrderVisible x:Key="AddOrderVisible"/>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
            Background="#00FA9A"
            BorderBrush="#7FFF00"
            BorderThickness="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0"
                   Source="/Resources/Images/Icon.png"
                   Margin="5"
                   HorizontalAlignment="Left"/>

                <Button x:Name="newOrderButton"
                        Grid.Column="1"
                        Margin="20 30"
                        Padding="30 0"
                        FontSize="24"
                        Background="White"
                        Content="Добавить заказ"
                        Click="newOrderButton_Click"
                        Visibility="{Binding CurrentUser.UserRole, Converter={StaticResource AddOrderVisible}}"/>
                
                <Button x:Name="backToCatalogButton"
                    Grid.Column="2"
                    Margin="20 30"
                    Padding="30 0"
                    FontSize="24"
                    Background="White"
                    Content="Назад"
                    Click="backToCatalogButton_Click"/>

                <TextBlock Grid.Column="3"
                       FontSize="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <Run Text="{Binding CurrentUser.UserFullName, Mode=OneWay}"/>
                <Run Text="{Binding CurrentUser.UserRole, StringFormat={}({0})}"/>
                </TextBlock>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
                <ItemsControl x:Name="shoesItemControl" ItemsSource="{Binding OrdersList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Margin="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:OrderControl/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="Заказов пока что нет" Grid.Row="1" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="24"
                   Visibility="{Binding OrdersList, Converter={StaticResource ProductListCountToCollapsed}}"/>
        </Grid>

    </Grid>
</Window>

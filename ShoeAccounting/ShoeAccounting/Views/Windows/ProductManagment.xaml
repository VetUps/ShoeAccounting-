<Window x:Class="ShoeAccounting.Views.Windows.ProductManagment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeAccounting.Views.Windows"
        mc:Ignorable="d"
        Title="Управление товаром" Height="900" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                   Text="Управление товаром"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="2" Grid.Column="0"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10"
                Background="#F9F9F9">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Изображение товара"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <Border BorderBrush="#AAAAAA" 
                        BorderThickness="1" 
                        CornerRadius="3"
                        Padding="2">
                    <Image x:Name="productImage"
                           Width="250" 
                           Height="180"
                           Stretch="Uniform"/>
                </Border>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <Button x:Name="btnLoadImage" 
                            Content="Загрузить"
                            Width="80"
                            Height="25"
                            Margin="5,0"
                            FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Grid.Column="0">
            <TextBlock Text="Наименование товара *"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,3"/>
            <TextBox x:Name="productTitleTextBox"
                     Height="28"
                     FontSize="14"
                     Padding="5"/>

            <TextBlock Text="Артикул *"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,15,0,3"/>
            <TextBox x:Name="productArticleTextBox"
                     Height="28"
                     FontSize="14"
                     Padding="5"/>

            <TextBlock Text="Категория"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,15,0,3"/>
            <ComboBox x:Name="productCategoryComboBox"
                      Height="28"
                      FontSize="14"
                      Padding="3"/>

            <TextBlock Text="Производитель"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,15,0,3"/>
            <ComboBox x:Name="productManufacturerComboBox"
                      Height="28"
                      FontSize="14"
                      Padding="3"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="2">
            <TextBlock Text="Цена товара (руб.) *"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,3"/>
            <TextBox x:Name="productPriceTextBox"
                     Height="28"
                     FontSize="14"
                     Padding="5"
                     TextAlignment="Right"/>

            <TextBlock Text="Скидка на товар (%)"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,15,0,3"/>
            <TextBox x:Name="productDiscountTextBox"
                     Height="28"
                     FontSize="14"
                     Padding="5"
                     TextAlignment="Right"/>

            <TextBlock Text="Количество на складе *"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,15,0,3"/>
            <TextBox x:Name="productQuantityInStockTextBox"
                     Height="28"
                     FontSize="14"
                     Padding="5"
                     TextAlignment="Right"/>

            <TextBlock Text="Единица измерения"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,15,0,3"/>
            <TextBox x:Name="productUnitTextBox"
                     Height="28"
                     FontSize="14"
                     Padding="5"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock Text="Описание товара"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,3"/>
            <TextBox x:Name="productDescriptionTextBox"
                     Height="80"
                     FontSize="14"
                     Padding="5"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3">
            <TextBlock Text="Поставщик товара"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,3"/>
            <ComboBox x:Name="productProviderComboBox"
                      Height="28"
                      FontSize="14"
                      Padding="3"/>
        </StackPanel>

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="btnSave" 
                    Content="Сохранить"
                    Width="120"
                    Height="35"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Margin="5"
                    Background="#4CAF50"
                    Foreground="White"/>

            <Button x:Name="btnCancel" 
                    Content="Отмена"
                    Width="120"
                    Height="35"
                    FontSize="14"
                    Margin="5"/>
        </StackPanel>

    </Grid>
</Window>
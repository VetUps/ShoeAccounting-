<UserControl x:Class="ShoeAccounting.Views.Controll.ProductControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ShoeAccounting.Views.Controll"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="1280"
             FontFamily="Times New Roman"
             FontSize="18">
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310"/>
            <ColumnDefinition Width="900*"/>
            <ColumnDefinition Width="300*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1"
                    Margin="10">
            <TextBlock FontSize="24">
                <Run Text="{Binding Category.CategoryTitle}"/>
                <Run Text=" | "/>
                <Run Text="{Binding ProductTitle}"/>
            </TextBlock>

            <TextBlock Text="{Binding ProductDescription, StringFormat={}Описание товара: {0}}"/>
            <TextBlock Text="{Binding Manufacturer.ManufacturerTitle, StringFormat={}Производитель: {0}}"/>
            <TextBlock Text="{Binding Provider.ProviderTitle, StringFormat={}Поставщик: {0}}"/>
            <TextBlock Text="{Binding ProductPrice, StringFormat={}Цена: {0} руб.}"/>
            <TextBlock Text="{Binding ProductUnit, StringFormat={}Еденица измерений: {0}}"/>
            <TextBlock Text="{Binding ProductQuantityInStock, StringFormat={}Количество на складе: {0} шт.}"/>
        </StackPanel>

        <TextBlock/>

    </Grid>
</UserControl>

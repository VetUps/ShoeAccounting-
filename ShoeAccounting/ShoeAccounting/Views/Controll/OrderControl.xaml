<UserControl x:Class="ShoeAccounting.Views.Controll.OrderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ShoeAccounting.Views.Controll"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="1280"
             FontFamily="Times New Roman"
             FontSize="18">
    <Grid>
        <Border BorderBrush="#7FFF00"
                BorderThickness="3"
                CornerRadius="5"
                Margin="5">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Margin="10">
                    <TextBlock Text="{Binding ProductArticle}"/>
                    <TextBlock Text="{Binding OrderStatus}"/>
                    <TextBlock>
                        <Run Text="{Binding PickUpPoint.PickUpPointCity}"/>
                        <Run Text="|"/>
                        <Run Text="{Binding PickUpPoint.PickUpPointStreet}"/>
                        <Run Text="{Binding PickUpPoint.PickUpPointHome}"/>
                        <Run Text="|"/>
                        <Run Text="{Binding PickUpPoint.PickUpPointPostalCode}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding OrderDateMake, StringFormat={}Дата заказа: {0}}"/>
                </StackPanel>

                <TextBlock Grid.Column="2" 
                           Text="{Binding OrderDateReceipt, StringFormat={}Дата получения: {0}}"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

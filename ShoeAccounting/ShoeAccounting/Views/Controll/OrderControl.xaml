<UserControl x:Class="ShoeAccounting.Views.Controll.OrderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ShoeAccounting.Views.Controll"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="1280"
             FontFamily="Times New Roman"
             FontSize="18">
    
    <UserControl.ContextMenu>
        <ContextMenu x:Name="orderManagmentContextMenu">
            <MenuItem x:Name="redactOrderButton"
                  Header="Редактировать" 
                  Click="redactOrderButton_Click"/>
            <MenuItem x:Name="deleteOrderButton"
                  Header="Удалить" 
                  Click="deleteOrderButton_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
    
    <Grid>
        <Border BorderBrush="#7FFF00"
                BorderThickness="3"
                CornerRadius="5"
                Margin="5">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Margin="10">
                    <Button x:Name="orderPositionsButton"
                            Content="Состав заказа"
                            FontSize="24"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            Click="orderPositionsButton_Click"/>
                    <TextBlock Text="{Binding OrderStatus, StringFormat={}Статус: {0}}"/>
                    <TextBlock>
                        <Run Text="Адрес пункта выдачи: "/>
                        <Run Text="{Binding PickUpPoint.DisplayAddress}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding OrderDateMake, StringFormat={}Дата заказа: {0:dd.MM.yyyy}}"/>
                </StackPanel>

                <TextBlock Grid.Column="2" 
                           Text="{Binding OrderDateReceipt, StringFormat={}Дата получения: {0:dd.MM.yyyy}}"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
